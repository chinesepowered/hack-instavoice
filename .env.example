# ---- Boson AI (voice cloning, TTS, Realtime, Avatar) -------------------------
# https://console.boson.ai  ->  API keys.  New accounts must claim the $10 trial
# credit before the first call or every request 429s.
BOSON_API_KEY=bai-xxxxxxxxxxxxxxxx

# ---- InstaCloud -------------------------------------------------------------
# insta login  ->  mint a durable token for CI/containers.
INSTA_API_KEY=insta_xxxxxxxxxxxxxxxx
INSTA_PROJECT_ID=
# Bound at `insta services add` time and shown in the infra panel.
INSTA_REGION=sin

# ---- Injected by InstaCloud at deploy time ----------------------------------
# insta secrets bind DATABASE_URL postgres/db --to compute/app
DATABASE_URL=
